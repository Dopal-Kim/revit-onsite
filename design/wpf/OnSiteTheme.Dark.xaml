<!--
  OnSiteTheme.Dark.xaml — Revit On-Site 도킹 창(대시보드) 다크 테마.
  색은 Revit 2026.3 다크 화면 특성 창 실측 (revit/screens/02_addins_tab.png, ui_spec §5·§7).
  OnSiteTheme.Light.xaml 과 키가 완전히 같다 → 둘 중 하나만 병합하고, 테마가 바뀌면 바꿔 끼운다.

  병합 (대시보드 UserControl, Style="{DynamicResource OnSite.Pane}"):
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="/RevitOnSite;component/Wpf/StatusColors.xaml"/>
          <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteTheme.Dark.xaml"/>   ← [1]번 자리
        </ResourceDictionary.MergedDictionaries>
      </ResourceDictionary>
    </UserControl.Resources>
  테마 교체 (UIApplication.ThemeChanged 또는 시작 시 UIThemeManager.CurrentTheme 확인):
    var name = UIThemeManager.CurrentTheme == UITheme.Dark ? "Dark" : "Light";
    pane.Resources.MergedDictionaries[1] = new ResourceDictionary {
        Source = new Uri($"/RevitOnSite;component/Wpf/OnSiteTheme.{name}.xaml", UriKind.Relative) };
  스타일은 OnSiteStyles.xaml 을 안에서 병합하고 색을 DynamicResource 로 참조하므로 즉시 다시 그려진다.
  (대시보드 XAML 에서도 색은 StaticResource 가 아니라 DynamicResource 로 써야 바뀐다.)

  주요 키: OnSite.Pane(뿌리) · OnSite.HeaderBand + OnSite.HeaderBandText(그룹 머리글 띠)
          OnSite.Chip + OnSite.ChipText(요약 칩) · OnSite.StatusCell(층×구역 칸) · OnSite.IconButton(▶ ❚❚)
          DataGrid·Slider·ScrollBar·DatePicker·ComboBox·Button 은 암시적 스타일.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OnSiteStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 크기: 특성 창 줄 높이(125 % 화면 24 px ≈ 19 DIP)에 맞춤, 모서리 없음 -->
    <sys:Double x:Key="OnSite.ControlHeight">21</sys:Double>
    <sys:Double x:Key="OnSite.RowHeight">19</sys:Double>
    <CornerRadius x:Key="OnSite.CornerRadius">0</CornerRadius>

    <!-- "실측" = 02_addins_tab.png 특성 창에서 잰 값 -->
    <SolidColorBrush x:Key="OnSite.Brush.Background"               Color="#3B4453"/> <!-- 실측 특성 창 바탕 -->
    <SolidColorBrush x:Key="OnSite.Brush.Foreground"               Color="#F5F5F5"/> <!-- 실측 -->
    <SolidColorBrush x:Key="OnSite.Brush.ForegroundDisabled"       Color="#989CA4"/> <!-- 실측 (축척 값) -->
    <SolidColorBrush x:Key="OnSite.Brush.ForegroundHint"           Color="#AEB5C0"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBackground"        Color="#3B4453"/> <!-- 실측 (편집... 버튼) -->
    <SolidColorBrush x:Key="OnSite.Brush.ControlBackgroundHover"   Color="#4A5568"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBackgroundPressed" Color="#3A7392"/> <!-- 실측 (눌린 정렬 버튼) -->
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorder"            Color="#7C8BA1"/> <!-- 실측 (편집... 버튼) -->
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorderBottom"      Color="#7C8BA1"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorderHover"       Color="#A9B7CA"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorderDisabled"    Color="#4A5463"/> <!-- 실측 (적용 버튼, 꺼짐) -->
    <SolidColorBrush x:Key="OnSite.Brush.InputBackground"          Color="#3B4453"/> <!-- 실측 (뷰 축척 칸) -->
    <SolidColorBrush x:Key="OnSite.Brush.FocusBorder"              Color="#C4BBAC"/> <!-- 실측 (편집 중인 칸) -->
    <SolidColorBrush x:Key="OnSite.Brush.Glyph"                    Color="#C8CDD5"/>
    <SolidColorBrush x:Key="OnSite.Brush.Accent"                   Color="#2B7BB3"/> <!-- 실측 선택 강조 -->
    <SolidColorBrush x:Key="OnSite.Brush.AccentForeground"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSite.Brush.HeaderBackground"         Color="#222933"/> <!-- 실측 (그래픽 띠) -->
    <SolidColorBrush x:Key="OnSite.Brush.HeaderForeground"         Color="#FFFFFF"/> <!-- 실측 -->
    <SolidColorBrush x:Key="OnSite.Brush.GridLine"                 Color="#485263"/> <!-- 실측 줄 구분선 -->
    <SolidColorBrush x:Key="OnSite.Brush.GroupBorder"              Color="#485263"/>
    <SolidColorBrush x:Key="OnSite.Brush.Error"                    Color="#FF7B6B"/>
    <SolidColorBrush x:Key="OnSite.Brush.ScrollTrack"              Color="#313945"/> <!-- 실측 -->
    <SolidColorBrush x:Key="OnSite.Brush.ScrollThumb"              Color="#758498"/> <!-- 실측 -->
    <SolidColorBrush x:Key="OnSite.Brush.PopupBackground"          Color="#3B4453"/>

</ResourceDictionary>
