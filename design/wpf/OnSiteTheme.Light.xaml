<!--
  OnSiteTheme.Light.xaml — Revit On-Site 도킹 창(대시보드) 라이트 테마.
  OnSiteTheme.Dark.xaml 과 키가 완전히 같다. 병합·교체 방법은 Dark 파일 머리말 참고.
  주의: 라이트 값은 Revit 라이트 화면 캡처가 아직 없어 Revit 특성 창 라이트 모양(흰 바탕·회색 띠)을 보고 정한 추정값이다.
        라이트 캡처가 생기면 아래 색만 실측값으로 바꾸면 된다 (스타일은 OnSiteStyles.xaml 하나).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="OnSiteStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="OnSite.ControlHeight">21</sys:Double>
    <sys:Double x:Key="OnSite.RowHeight">19</sys:Double>
    <CornerRadius x:Key="OnSite.CornerRadius">0</CornerRadius>

    <SolidColorBrush x:Key="OnSite.Brush.Background"               Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSite.Brush.Foreground"               Color="#000000"/>
    <SolidColorBrush x:Key="OnSite.Brush.ForegroundDisabled"       Color="#8C8C8C"/>
    <SolidColorBrush x:Key="OnSite.Brush.ForegroundHint"           Color="#6D6D6D"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBackground"        Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBackgroundHover"   Color="#E5F1FB"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBackgroundPressed" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorder"            Color="#ADADAD"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorderBottom"      Color="#ADADAD"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorderHover"       Color="#2B7BB3"/>
    <SolidColorBrush x:Key="OnSite.Brush.ControlBorderDisabled"    Color="#D9D9D9"/>
    <SolidColorBrush x:Key="OnSite.Brush.InputBackground"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSite.Brush.FocusBorder"              Color="#2B7BB3"/>
    <SolidColorBrush x:Key="OnSite.Brush.Glyph"                    Color="#5E5E5E"/>
    <SolidColorBrush x:Key="OnSite.Brush.Accent"                   Color="#2B7BB3"/>
    <SolidColorBrush x:Key="OnSite.Brush.AccentForeground"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnSite.Brush.HeaderBackground"         Color="#E5E5E5"/>
    <SolidColorBrush x:Key="OnSite.Brush.HeaderForeground"         Color="#000000"/>
    <SolidColorBrush x:Key="OnSite.Brush.GridLine"                 Color="#D9D9D9"/>
    <SolidColorBrush x:Key="OnSite.Brush.GroupBorder"              Color="#D9D9D9"/>
    <SolidColorBrush x:Key="OnSite.Brush.Error"                    Color="#C42B1C"/>
    <SolidColorBrush x:Key="OnSite.Brush.ScrollTrack"              Color="#F0F0F0"/>
    <SolidColorBrush x:Key="OnSite.Brush.ScrollThumb"              Color="#C2C2C2"/>
    <SolidColorBrush x:Key="OnSite.Brush.PopupBackground"          Color="#FFFFFF"/>

</ResourceDictionary>
