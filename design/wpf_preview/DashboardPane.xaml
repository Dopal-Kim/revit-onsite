<!--
  대시보드 도킹 창 (ui_spec §5) — OnSiteTheme.*.xaml + StatusColors.xaml 사용 예.
  색은 전부 DynamicResource → ApplyTheme() 로 테마 사전을 바꿔 끼우면 즉시 다시 그려진다.
  창 제목 띠("Revit On-Site" ✕)는 Revit 이 그리므로 여기엔 없다 (미리보기 Program.cs 가 흉내만 냄).
-->
<UserControl x:Class="OnSitePreview.DashboardPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource OnSite.Pane}" Language="ko-KR" Width="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="wpf/StatusColors.xaml"/>
                <ResourceDictionary Source="wpf/OnSiteTheme.Light.xaml"/> <!-- [1] ApplyTheme 가 교체 -->
            </ResourceDictionary.MergedDictionaries>
            <!-- 특성 창 그룹 띠 오른쪽의 접기 표시 -->
            <Geometry x:Key="CollapseGlyph">M0,4 L3,1 L6,4 M0,8 L3,5 L6,8</Geometry>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 격자 줄만 * : 도킹 창 높이가 줄면 격자가 스크롤된다 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- 1. 기준일 줄 -->
        <DockPanel Grid.Row="0" Margin="6,6,6,5">
            <TextBlock Text="기준일" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <Button DockPanel.Dock="Right" Content="판정" Margin="4,0,0,0" MinWidth="44"/>
            <Button DockPanel.Dock="Right" Content="오늘" Margin="4,0,0,0" MinWidth="44"/>
            <DatePicker x:Name="BaseDate" Width="Auto" SelectedDate="2026-12-03"/>
        </DockPanel>

        <!-- 2. 요약 칩 -->
        <WrapPanel Grid.Row="1" Margin="6,0,2,2">
            <Border Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.ReadyToRequest}">
                <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.ReadyToRequest.Fg}" x:Name="ChipReady"/>
            </Border>
            <Border Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.Extended}">
                <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.Extended.Fg}" x:Name="ChipKeep"/>
            </Border>
            <Border Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.NeedsCylinder}">
                <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.NeedsCylinder.Fg}" x:Name="ChipCyl"/>
            </Border>
        </WrapPanel>

        <!-- 3. 층 × 구역 격자 -->
        <Border Grid.Row="2" Style="{StaticResource OnSite.HeaderBand}">
            <DockPanel>
                <Path DockPanel.Dock="Right" Data="{StaticResource CollapseGlyph}" Stroke="{DynamicResource OnSite.Brush.HeaderForeground}"
                      StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <TextBlock Style="{StaticResource OnSite.HeaderBandText}" Text="층 × 구역 현황"/>
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="3" x:Name="Matrix" BorderThickness="0" IsReadOnly="True" HorizontalScrollBarVisibility="Disabled"/>

        <!-- 4. 타임라인 -->
        <Border Grid.Row="4" Style="{StaticResource OnSite.HeaderBand}">
            <DockPanel>
                <Path DockPanel.Dock="Right" Data="{StaticResource CollapseGlyph}" Stroke="{DynamicResource OnSite.Brush.HeaderForeground}"
                      StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <TextBlock Style="{StaticResource OnSite.HeaderBandText}" Text="타임라인"/>
            </DockPanel>
        </Border>
        <DockPanel Grid.Row="5" Margin="4,5,6,5">
            <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.IconButton}" ToolTip="재생">
                <Path Data="M0,0 L8,5 L0,10 Z" Fill="{DynamicResource OnSite.Brush.Foreground}"/>
            </Button>
            <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.IconButton}" ToolTip="일시 정지">
                <Path Data="M0,0 H3 V10 H0 Z M5,0 H8 V10 H5 Z" Fill="{DynamicResource OnSite.Brush.Foreground}"/>
            </Button>
            <ComboBox DockPanel.Dock="Right" Width="68" SelectedIndex="0" ToolTip="재생 속도">
                <ComboBoxItem Content="1일/초"/>
                <ComboBoxItem Content="1주/초"/>
            </ComboBox>
            <TextBlock DockPanel.Dock="Right" x:Name="SliderDate" Text="12-03" VerticalAlignment="Center" Margin="6,0,6,0"/>
            <Slider x:Name="Timeline" Minimum="0" Maximum="140" Value="63" VerticalAlignment="Center" Margin="4,0,0,0"/>
        </DockPanel>

        <!-- 5. 경고 목록 -->
        <Border Grid.Row="6" Style="{StaticResource OnSite.HeaderBand}">
            <DockPanel>
                <Path DockPanel.Dock="Right" Data="{StaticResource CollapseGlyph}" Stroke="{DynamicResource OnSite.Brush.HeaderForeground}"
                      StrokeThickness="1" VerticalAlignment="Center" Margin="0,0,3,0"/>
                <TextBlock Style="{StaticResource OnSite.HeaderBandText}" x:Name="WarnHeader" Text="경고"/>
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="7" x:Name="Warnings" MaxHeight="120" BorderThickness="0" IsReadOnly="True" HeadersVisibility="None"
                  GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
