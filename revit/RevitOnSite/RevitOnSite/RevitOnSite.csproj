<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revit On-Site 애드인 (Revit 2026 = .NET 8). 빌드: dotnet build -c Release → bin\Release\net8.0-windows\ 를 Addins\2026\RevitOnSite\ 로 복사 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <RevitDir>C:\Program Files\Autodesk\Revit 2026</RevitDir>
    <!-- RevitAPI 가 WinForms 시절 System.Drawing·Microsoft.VisualBasic 를 참조해서 나는 버전 충돌 경고. 실행 때는 Revit 이 제공하므로 메시지로만 -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <!-- Copy Local 끔: Revit 이 이미 로드한 API 를 쓴다. AdWindows = 비공식 리본 API (상황별 탭, ui_spec §4) -->
    <Reference Include="RevitAPI"><HintPath>$(RevitDir)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitDir)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AdWindows"><HintPath>$(RevitDir)\AdWindows.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- 계산 엔진 (engine.py·evaluate.py·schedule.py 이식, Python 일치 시험 RevitOnSite.Engine.Check) -->
    <ProjectReference Include="..\RevitOnSite.Engine\RevitOnSite.Engine.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 리본 아이콘 (design\icons 사본). DLL 안에 "<이름>_<16|32>[_dark].png" 로 들어감 -->
    <EmbeddedResource Include="Icons\*.png" LogicalName="%(Filename)%(Extension)" />
    <!-- 큰 버튼 툴팁 그림 (design\tooltips 사본, 320×180) → "tip_<이름>.png" -->
    <EmbeddedResource Include="Tooltips\*.png" LogicalName="tip_%(Filename)%(Extension)" />
    <None Include="..\..\SHR_SharedParameters.txt" Link="SHR_SharedParameters.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\families\*.rfa" LinkBase="Families" CopyToOutputDirectory="PreserveNewest" />
    <None Update="RevitOnSite.addin" CopyToOutputDirectory="PreserveNewest" />
    <!-- 4D 미리보기 끄개 {"preview4d": false} — DLL 옆에서 ▶ 때마다 읽음 (Timeline.PreviewEnabled) -->
    <None Update="onsite.settings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 현장 휴대폰 화면 web/field/*.html (입력 index.html · 층 화면·해체 신고 view.html F12·F14) — 서버가 DLL 옆 web\field 에서 돌려줌 (FieldInput.cs).
         27차: view.html 이 빠져 /view 500 → 폴더의 html 을 통째로 (새 html 도 자동). Field.Check 가 출력 폴더에 모두 있는지 확인 -->
    <None Include="..\..\..\web\field\*.html" LinkBase="web\field" CopyToOutputDirectory="PreserveNewest" />
    <!-- 도움말 docs\help (index·quickstart·cmd\*) → 애드인 폴더 help\ (App.HelpFile, 코드 검토 2차) -->
    <None Include="..\..\..\docs\help\**\*.*" LinkBase="help" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
