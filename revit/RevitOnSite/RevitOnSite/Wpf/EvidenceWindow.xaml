<!--
  근거 원장 추가 대화상자 — 고른 구역에 해체 절차 단계 서류 한 건(단계·날짜·문서번호·결과·입력자·파일)을 evidence.csv 에 이어 쓴다 (Engine.Evidence = evidence.py).
  원본은 서명된 서류이고 원장에는 파일 경로와 SHA-256 만 남는다. 프로그램은 승인·해체를 지시하지 않는다.
-->
<Window x:Class="RevitOnSite.EvidenceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="근거 원장 추가" WindowStartupLocation="CenterOwner" Style="{DynamicResource OnSite.DialogWindow}" Language="ko-KR">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteDialog.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,3"/>
            </Style>
            <Style x:Key="Error" TargetType="TextBlock" BasedOn="{StaticResource OnSite.ValidationText}">
                <Setter Property="Margin" Value="118,-1,0,3"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help"/>
    </Window.CommandBindings>

    <Border Background="{DynamicResource OnSite.Brush.Background}" Padding="12">
        <StackPanel Width="470">
            <GroupBox Header="고른 구역 (지금 갖춘 근거)">
                <TextBlock x:Name="ZonesText" TextWrapping="Wrap" Margin="4,2"/>
            </GroupBox>
            <GroupBox Header="서류" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="단계(_S):" Target="{Binding ElementName=Stage}"/>
                        <ComboBox x:Name="Stage" Width="200" SelectionChanged="Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="StageHint" Style="{StaticResource OnSite.HintText}" Margin="118,0,0,3" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left"/>
                    <!-- 11-12 2-4 Revit #15: 같은 날·같은 입력자로 다른 단계도 함께 (문서번호·파일은 위 단계에만) -->
                    <WrapPanel x:Name="AlsoPanel" Margin="118,0,0,3"/>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="날짜(_D):" Target="{Binding ElementName=Day}"/>
                        <DatePicker x:Name="Day" SelectedDateChanged="Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="DayError" Style="{StaticResource Error}" Text="서류 날짜를 고르세요."/>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="문서번호(_O):" Target="{Binding ElementName=DocNo}"/>
                        <TextBox x:Name="DocNo" Width="200" MaxLength="40"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="결과(_R):" Target="{Binding ElementName=ResultBox}"/>
                        <TextBox x:Name="ResultBox" Width="200" MaxLength="40"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="입력자(_N):" Target="{Binding ElementName=Actor}"/>
                        <TextBox x:Name="Actor" Width="200" MaxLength="20" TextChanged="Changed"/>
                    </StackPanel>
                    <TextBlock x:Name="ActorError" Style="{StaticResource Error}" Text="입력자 이름을 넣으세요."/>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="파일(_F):" Target="{Binding ElementName=FileBox}"/>
                        <TextBox x:Name="FileBox" Width="250" TextChanged="Changed"/>
                        <Button Content="찾아보기(_B)…" Margin="6,0,0,0" Click="Browse"/>
                    </StackPanel>
                    <TextBlock x:Name="FileError" Style="{StaticResource Error}" Text="파일이 없습니다. 비우거나 있는 파일을 고르세요."/>
                    <TextBlock Style="{StaticResource OnSite.HintText}" Margin="118,-1,0,3" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left"
                               Text="스캔본·PDF 등 서명된 원본. 원장에는 경로와 SHA-256 만 남아, 파일을 바꾸면 값이 달라집니다."/>
                </StackPanel>
            </GroupBox>

            <TextBlock Style="{StaticResource OnSite.HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="기록은 데이터 폴더 evidence.csv 에 한 줄씩 이어 씁니다 (고치지 않고 추가만). 모델은 바꾸지 않습니다."/>

            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.HelpButton}" Command="Help"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="취소" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="추가" IsDefault="True" x:Name="OkButton" Click="Ok"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
