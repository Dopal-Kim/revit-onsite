<!--
  대시보드 도킹 창 (ui_spec §5) — design/wpf_preview 이식. 등록·데이터 = Dashboard.cs, 모델을 건드리는 일은 전부 ExternalEvent 로.
  색은 전부 DynamicResource → ApplyTheme() 로 테마 사전을 바꿔 끼우면 즉시 다시 그려진다. 창 제목 띠("Revit On-Site")는 Revit 이 그린다.
  타임라인 막대(§5-4)는 4D 타임라인 단계에서 켠다 (지금은 접어 둠).
-->
<UserControl x:Class="RevitOnSite.DashboardPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Style="{DynamicResource OnSite.Pane}" Language="ko-KR" MinWidth="260">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/StatusColors.xaml"/>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteTheme.Light.xaml"/> <!-- [1] ApplyTheme 가 교체 -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 11-12 2-5: 순서 = 오늘 할 일 → 기준일 → 오늘 볼 것·칩·안내·지표 → 범례 → 층 × 구역 격자 → 동바리 → 강도 예측 타임라인(접힘) → 경고.
         RevitOnSite.Layout.Check 가 창 400–1080 px × 오늘 볼 것 펼침/접힘에서 순서·격자 첫 줄이 첫 화면 안(접힘)·타임라인 접힘 시작·펼치면 그림 160 px 을 시험 -->
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="RootPanel">
            <!-- v6.2 W13 오늘 할 일 (순서대로 누르면 하루 일이 끝남 — 단추는 기존 명령 그대로) + 역할 보기 (보이는 단추·오늘 볼 것 줄만, 기능 같음) -->
            <DockPanel Margin="6,6,6,0">
                <ComboBox DockPanel.Dock="Right" x:Name="RoleBox" Width="64" SelectionChanged="RoleChanged" AutomationProperties.Name="역할 보기"
                          ToolTip="역할 보기 — 그 역할의 단추와 '오늘 볼 것' 줄만 보입니다 (기능·판정은 같음). 이 PC 에 기억.">
                    <ComboBoxItem Content="전체"/>
                    <ComboBoxItem Content="공무"/>
                    <ComboBoxItem Content="안전"/>
                    <ComboBoxItem Content="품질"/>
                </ComboBox>
                <WrapPanel x:Name="TodaySteps" AutomationProperties.Name="오늘 할 일">
                    <TextBlock Text="오늘 할 일" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold"/>
                    <Button x:Name="StepJudge" Content="① 판정" Margin="2,0" Padding="4,1" PreviewMouseLeftButtonUp="TodayUp2" Click="TodayClick2" ToolTip="기준일로 해체 판정 (아래 [판정]과 같음)"/>
                    <Button x:Name="StepAlerts" Content="② 오늘 볼 것" Margin="2,0" Padding="4,1" PreviewMouseLeftButtonUp="TodayUp2" Click="TodayClick2" ToolTip="오늘 볼 것 목록을 펼칩니다"/>
                    <Button x:Name="StepRequest" Content="③ 요청서" Margin="2,0" Padding="4,1" PreviewMouseLeftButtonUp="TodayUp2" Click="TodayClick2" ToolTip="해체 검측요청서 (리본 [검측요청서]와 같음)"/>
                    <Button x:Name="StepSign" Content="④ 층 표지" Margin="2,0" Padding="4,1" PreviewMouseLeftButtonUp="TodayUp2" Click="TodayClick2" ToolTip="층 표지 인쇄용 (리본 [층 표지]와 같음)"/>
                </WrapPanel>
            </DockPanel>
            <!-- 1. 기준일 줄 -->
            <DockPanel Margin="6,6,6,5">
                <TextBlock Text="기준일" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <!-- 도킹 창에 포커스가 없을 때 첫 클릭의 누름이 창 활성화에 쓰여 Click 이 안 생김 (5차 점검 B1) → 마우스는 놓을 때(PreviewMouseLeftButtonUp) 바로 실행.
                     키보드(Tab → Space/Enter)·화면 읽기(UI Automation Invoke)는 Click 으로 같은 동작 (11차 점검 N7) — 마우스 직후 Click 은 한 번만 실행되게 거름 -->
                <Button DockPanel.Dock="Right" Content="판정" Margin="4,0,0,0" MinWidth="44" PreviewMouseLeftButtonUp="JudgeUp" Click="JudgeClick"
                        ToolTip="이 기준일로 해체 판정을 다시 합니다 (모델의 판정 값과 검측 뷰 색이 바뀝니다)."/>
                <Button DockPanel.Dock="Right" Content="오늘" Margin="4,0,0,0" MinWidth="44" PreviewMouseLeftButtonUp="TodayUp" Click="TodayClick"/>
                <DatePicker x:Name="BaseDate" Width="Auto"/>
            </DockPanel>


            <!-- 2. 요약 칩 + 안내 한 줄 -->
            <StackPanel x:Name="SummaryPanel" Margin="6,0,2,2">
                <!-- 오늘 볼 것 (D4, Engine.Alerts = alerts.py) — 있을 때만. 펼치면 층별 토글 목록, 줄을 누르면(또는 Space·Enter) 그 구역 선택·확대 (ui_reference_research 7절 #3) -->
                <Expander x:Name="AlertBox" Margin="0,0,4,2" Visibility="Collapsed" AutomationProperties.Name="오늘 볼 것">
                    <Expander.Header>
                        <TextBlock x:Name="AlertLine" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource OnSite.Brush.Error}"/>
                    </Expander.Header>
                    <!-- 79차 (사용자 11-08 "토글 사용해서 몇 층 열람 이후 해당 층 어느 구역이 존재하는지" · 총괄): 층 줄 '13F ▸ ■ 무단 해체 의심 1 · 요청 가능 3 · 존치 2'
                         → 누르면 그 층 알림·요청 가능 구역 줄이 펼쳐짐 (BuildFloors). 높이 = 내용만큼 (85차: 패널 전체 스크롤 하나 — 창이 낮으면 아래로 내려가 스크롤) -->
                    <Border x:Name="FloorScroll" Margin="0,2,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="FloorList" AutomationProperties.Name="오늘 볼 것 층별 목록"/>
                    </Border>
                </Expander>
                <WrapPanel x:Name="Chips">
                    <Border Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.ReadyToRequest}">
                        <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.ReadyToRequest.Fg}" x:Name="ChipReady"/>
                    </Border>
                    <Border Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.Extended}">
                        <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.Extended.Fg}" x:Name="ChipKeep"/>
                    </Border>
                    <Border Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.NeedsCylinder}">
                        <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.NeedsCylinder.Fg}" x:Name="ChipCyl"/>
                    </Border>
                    <!-- 승인 기록(approvals.csv) 상태 6·7·8 — 있을 때만 (10차 점검 N6) -->
                    <Border x:Name="ChipApprovedBox" Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.Approved}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.Approved.Fg}" x:Name="ChipApproved"/>
                    </Border>
                    <Border x:Name="ChipRemovedBox" Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.Removed}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.Removed.Fg}" x:Name="ChipRemoved"/>
                    </Border>
                    <Border x:Name="ChipReshoredBox" Style="{StaticResource OnSite.Chip}" Background="{DynamicResource OnSite.Status.Reshored}" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource OnSite.ChipText}" Foreground="{DynamicResource OnSite.Status.Reshored.Fg}" x:Name="ChipReshored"/>
                    </Border>
                </WrapPanel>
                <TextBlock x:Name="Info" TextWrapping="Wrap" Margin="0,2,4,2" Foreground="{DynamicResource OnSite.Brush.ForegroundHint}" Visibility="Collapsed"/>
                <!-- 파장 지표 (Engine.Kpi = kpi.py, impact_map 1절) — 판정 뒤에만, 툴팁에 다섯 줄. 11-12 2-5: 칩·안내 아래, 줄바꿈 (Revit #4 '감리 확인 시간' 줄 잘림) -->
                <TextBlock x:Name="KpiLine" Margin="0,0,4,2" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource OnSite.Brush.ForegroundHint}" AutomationProperties.Name="지표"/>
            </StackPanel>

            <!-- 11-12 2-5 (Revit #5): 범례 = 지금 활성 뷰의 실제 색 기준 (검측 뷰·평면 = 상태 0–9 / [표시: 강도·일정] / 강도 타임라인 뷰 = [색] 콤보 / [색: 동바리 상태] = 동바리 상태). RebuildLegend 가 채움 -->
            <WrapPanel x:Name="Legend" Margin="8,2,4,2" MaxHeight="40" AutomationProperties.Name="색 범례"/>

            <!-- 3. 층 × 구역 격자: 칸 클릭 = 모델에서 그 구역 선택·확대, 두 번 클릭 = 판정 근거 -->
            <Border Style="{StaticResource OnSite.HeaderBand}">
                <TextBlock Style="{StaticResource OnSite.HeaderBandText}" x:Name="MatrixHeader" Text="층 × 구역 현황 (칸 글자 = 상태 약자 · 예측 해체일)"/>
            </Border>
            <DataGrid x:Name="Matrix" VerticalAlignment="Top" MaxHeight="300" BorderThickness="0" IsReadOnly="True" SelectionUnit="Cell" SelectionMode="Single"
                      CanUserSortColumns="False" CanUserReorderColumns="False" HorizontalScrollBarVisibility="Auto"
                      PreviewMouseLeftButtonUp="CellClick" MouseDoubleClick="CellDoubleClick"/>

            <!-- 3-1. 구역 보기 (P8): 칸·모델에서 구역을 고르면 검측 3D 에 강조 덧그림(ZoneFocus, 실행 취소 없음). 동바리 표시 방식 + 같은 층만 / 전체 층 (단면 상자, 버튼일 때만 뷰 재지정) -->
            <DockPanel Margin="6,4,6,4">
                <TextBlock Text="동바리" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Button DockPanel.Dock="Right" Content="전체 층" Margin="4,0,0,0" MinWidth="52" PreviewMouseLeftButtonUp="AllFloorsUp" Click="AllFloorsClick"
                        ToolTip="검측 3D 의 단면 상자를 판정 대상 층 슬래브 윗면까지로 되돌리고 흐리게 한 구역을 원래대로 (뷰 표시만 바뀝니다)."/>
                <Button DockPanel.Dock="Right" Content="같은 층만" Margin="4,0,0,0" MinWidth="60" PreviewMouseLeftButtonUp="SameFloorUp" Click="SameFloorClick"
                        ToolTip="고른 구역(없으면 판정 대상 층)의 층만 단면 상자로 잘라 같은 층 구역끼리 비교합니다. 고른 구역 말고는 흐리게 (뷰 표시만 바뀝니다)."/>
                <ComboBox x:Name="ShoreMode" SelectedIndex="0" SelectionChanged="ShoreModeChanged" AutomationProperties.Name="동바리 표시"
                          ToolTip="검측 3D 에 보일 동바리: 선택 구역만(기본 — 고른 구역 동바리를 진하게 덧그리고, 뷰에는 판정 대상 층만) / 판정 대상 층만 / 전부 / 숨김. 판정 대상 층 = 해체 승인 요청 가능·존치 연장·공시체 시험 필요 구역이 있는 가장 높은 층">
                    <ComboBoxItem Content="선택 구역만"/>
                    <ComboBoxItem Content="판정 대상 층만"/>
                    <ComboBoxItem Content="전부"/>
                    <ComboBoxItem Content="숨김"/>
                </ComboBox>
            </DockPanel>

            <!-- 11-12 2-5 (Revit #4): 강도 예측 타임라인(판정에 안 씀)은 접힌 채 시작 — 첫 화면 = 오늘 볼 것 → 칩 → 층 × 구역. ▶·[강도 타임라인]이 세션을 열면 펼침 (SetTimeline) -->
            <Expander x:Name="TimelineBox" IsExpanded="False" Margin="0,4,0,0" AutomationProperties.Name="강도 예측 타임라인">
                <Expander.Header>
                    <TextBlock Text="강도 예측 타임라인 (참고 · 판정에 안 씀 · 화면에만)" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel>
                    <!-- 재생 줄·사건 단추 → 강도 그림 (펼치면) → 그날 줄·안내. ▶·❚❚ 위치는 재생 상태와 무관 (8차 점검 N2: 그날 줄 높이 고정) -->
                    <StackPanel x:Name="TimelinePanel" Margin="4,5,6,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.IconButton}" ToolTip="재생 (처음이면 강도 예측을 계산하고 강도 타임라인 뷰를 엽니다)"
                                    AutomationProperties.Name="재생" PreviewMouseLeftButtonUp="PlayUp" Click="PlayClick">
                                <Path Data="M0,0 L8,5 L0,10 Z" Fill="{DynamicResource OnSite.Brush.Foreground}"/>
                            </Button>
                            <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.IconButton}" ToolTip="멈춤" AutomationProperties.Name="멈춤" PreviewMouseLeftButtonDown="PauseUp" PreviewMouseLeftButtonUp="PauseUp" Click="PauseClick">
                                <Path Data="M0,0 H3 V10 H0 Z M5,0 H8 V10 H5 Z" Fill="{DynamicResource OnSite.Brush.Foreground}"/>
                            </Button>
                            <ComboBox DockPanel.Dock="Right" x:Name="Speed" Width="68" SelectedIndex="0" ToolTip="재생 속도">
                                <ComboBoxItem Content="1일/초"/>
                                <ComboBoxItem Content="1주/초"/>
                            </ComboBox>
                            <TextBlock DockPanel.Dock="Right" x:Name="SliderDate" Text="" VerticalAlignment="Center" Margin="6,0,6,0"/>
                            <Slider x:Name="TimelineSlider" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="4,0,0,0" IsEnabled="False"
                                    SmallChange="1" LargeChange="7" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderMoved"/>
                        </DockPanel>
                        <!-- 하루 한 칸 · 사건(층 타설·추정 14 MPa·fck 도달·공시체 시험) 사이 건너뛰기. 누르면 재생은 멈추고 그날 -->
                        <WrapPanel Margin="0,3,0,0">
                            <Button Content="처음" Tag="0" MinWidth="40" Margin="0,0,3,0" PreviewMouseLeftButtonUp="StepUp" Click="StepClick" AutomationProperties.Name="처음"
                                    ToolTip="첫 타설일로 — 타임라인은 마지막 판정일에서 시작합니다"/>
                            <Button Content="◀ 하루" Tag="-1" MinWidth="50" Margin="0,0,3,0" PreviewMouseLeftButtonUp="StepUp" Click="StepClick" AutomationProperties.Name="하루 전" ToolTip="하루 전"/>
                            <Button Content="하루 ▶" Tag="1" MinWidth="50" Margin="0,0,9,0" PreviewMouseLeftButtonUp="StepUp" Click="StepClick" AutomationProperties.Name="하루 뒤" ToolTip="하루 뒤"/>
                            <Button Content="|◀ 사건" Tag="-e" MinWidth="56" Margin="0,0,3,0" PreviewMouseLeftButtonUp="StepUp" Click="StepClick" AutomationProperties.Name="앞 사건"
                                    ToolTip="앞 사건 날로: 층 타설 · 층 추정 14 MPa(지지 슬래브 기준)·fck 도달(참고) · 공시체 시험"/>
                            <Button Content="사건 ▶|" Tag="e" MinWidth="56" PreviewMouseLeftButtonUp="StepUp" Click="StepClick" AutomationProperties.Name="다음 사건"
                                    ToolTip="다음 사건 날로: 층 타설 · 층 추정 14 MPa(지지 슬래브 기준)·fck 도달(참고) · 공시체 시험"/>
                        </WrapPanel>
                        <!-- 85차: 높이 160 고정 (줄이지 않음 — 5·14·fck 선·축·'MPa'). 강도 예측 그림 (v6 3단계): 회색 선 = 층별 추정 강도(그 층 타설된 구역 최소, 참고), 점 = 지금 날짜의 층별 값(강도 색), ◆ = 그날까지 현장양생 공시체 실측(초록 = fck 이상),
                             가로 파선 = 기준선 5 측면 거푸집 · 14 지지 슬래브 · fck, 빨간 세로선 = 지금 -->
                        <Canvas x:Name="ProcessChart" Height="160" Margin="2,6,2,0" ClipToBounds="True" SizeChanged="ChartResized" Visibility="Hidden" AutomationProperties.Name="강도 예측 그림"
                                ToolTip="강도 예측 (참고 · 판정에 안 씀): 회색 선 = 층별 추정 강도 (그 층에서 그날까지 타설된 구역 중 가장 낮은 값, 기온 = 기상 기록 또는 평년, 양생 하한·층 높이 보정은 [프로젝트 설정]). 점 = 지금 날짜의 위 4개층 값. ◆ = 그날까지 현장양생 공시체 실측 평균 (초록 = fck 이상, 누르면 그날로). 가로 파선 = 기준선 5 MPa 측면 거푸집 · 14 MPa 지지 슬래브 · fck. 판정은 공시체·3 m 안 센서 실측으로만 합니다."/>
                        <!-- 그날 위층 추정 강도·사건 (FourD.DoingLine, 프레임마다). 높이 고정 (N2) -->
                        <TextBlock x:Name="DoingText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="34" Margin="4,4,0,0" FontWeight="SemiBold"
                                   AutomationProperties.Name="그날 추정 강도와 사건"/>
                        <!-- 84차: 비었으면 접음 (그림 아래라 버튼 위치는 안 바뀜) — 1080 창 598 px 에서 그림이 창 밖이었음 -->
                        <TextBlock x:Name="TimelineNoteText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="4,4,0,0" Visibility="Collapsed" Foreground="{DynamicResource OnSite.Brush.ForegroundHint}"/>
                    </StackPanel>
                    <!-- 4D 색·재생 전 뷰 -->
                    <StackPanel x:Name="TimelineMore" Margin="4,0,6,5">
                        <!-- 구역 색: 추정 강도(참고) / 근거 단계 (근거 원장 1–8, 회색 0 → 진녹색 8) / 동바리 상태(검측 뷰) -->
                        <DockPanel Margin="4,4,0,0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="색" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox DockPanel.Dock="Left" x:Name="ColorMode" Width="150" SelectedIndex="0" SelectionChanged="ColorModeChanged" AutomationProperties.Name="4D 구역 색"
                                      ToolTip="강도 타임라인의 구역 색: 추정 강도(기본, 추정 ÷ fck — 참고, 판정에 안 씀) 또는 근거 단계 — 근거 원장에서 1 설치검측부터 빈칸 없이 갖춘 마지막 단계, 회색 0 → 진녹색 8. 그날 넣은 서류는 다음 날부터 셉니다 (웹 공유판과 같음). 동바리 상태 = 검측 뷰의 동바리를 기록 기준 상태로 칠함 (타임라인은 추정 강도 색)">
                                <ComboBoxItem Content="추정 강도 (참고)"/>
                                <ComboBoxItem Content="근거 단계 (1–8)"/>
                                <ComboBoxItem Content="동바리 상태 (검측 뷰)"/>
                            </ComboBox>
                            <!-- 근거 단계 색 견본 0–8 (FourD.EvidenceColor, 코드에서 채움) -->
                            <StackPanel DockPanel.Dock="Left" x:Name="EvSwatches" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </DockPanel>
                        <WrapPanel Margin="4,4,0,0">
                            <CheckBox x:Name="RestoreView" IsChecked="True" Margin="0,0,10,0" Content="멈추거나 닫으면 재생 전 뷰로" ToolTip="멈추거나 창을 닫으면 재생 전 뷰로 돌아가기"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <!-- 5. 경고 목록: 존치 사유 + 공정 계획 경고 -->
            <Border Style="{StaticResource OnSite.HeaderBand}">
                <TextBlock Style="{StaticResource OnSite.HeaderBandText}" x:Name="WarnHeader" Text="경고"/>
            </Border>
            <DataGrid x:Name="Warnings" BorderThickness="0" IsReadOnly="True" HeadersVisibility="None" RowHeight="NaN" MinRowHeight="20"
                      VerticalAlignment="Top" MaxHeight="260"
                      GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <!-- 두 줄까지 (ui_reference_research 7절 #6), 넘치면 … · 전체는 툴팁 -->
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="MaxHeight" Value="38"/>
                                <Setter Property="ToolTip" Value="{Binding}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
