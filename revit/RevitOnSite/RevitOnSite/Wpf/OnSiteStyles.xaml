<!--
  OnSiteStyles.xaml — Revit On-Site 공용 컨트롤 스타일 (색은 들어 있지 않음).

  직접 병합하지 않는다. 아래 세 파일이 각자 색(브러시)을 정의하고 이 파일을 안에서 병합한다:
    OnSiteDialog.xaml       — 모달 대화상자 (항상 라이트, Revit "열기" 창과 같은 Windows 11 모양)
    OnSiteTheme.Light.xaml  — 도킹 창 라이트
    OnSiteTheme.Dark.xaml   — 도킹 창 다크 (Revit 특성 창 실측색)
  여기서는 색·크기를 전부 DynamicResource 로만 참조하므로, 테마 파일을 바꿔 끼우면
  (UIApplication.ThemeChanged) 이미 떠 있는 컨트롤도 즉시 새 색으로 다시 그려진다.

  색 파일이 반드시 정의해야 하는 키 (세 파일 모두 같음):
    브러시  OnSite.Brush.Background / Foreground / ForegroundDisabled / ForegroundHint
            OnSite.Brush.ControlBackground / ControlBackgroundHover / ControlBackgroundPressed
            OnSite.Brush.ControlBorder / ControlBorderBottom / ControlBorderHover / ControlBorderDisabled
            OnSite.Brush.InputBackground / FocusBorder / Glyph / Accent / AccentForeground
            OnSite.Brush.HeaderBackground / HeaderForeground / GridLine / GroupBorder / Error
            OnSite.Brush.ScrollTrack / ScrollThumb / PopupBackground
    크기    OnSite.ControlHeight (Double) / OnSite.RowHeight (Double) / OnSite.CornerRadius (CornerRadius)

  암시적 스타일(키 없음): Label TextBox ComboBox ComboBoxItem CheckBox Button DatePicker GroupBox
                         Slider ScrollBar DataGrid DataGridColumnHeader DataGridCell
  키 스타일: OnSite.FieldLabel OnSite.NumberBox OnSite.UnitText OnSite.HintText OnSite.ValidationText
             OnSite.DialogButton OnSite.HelpButton OnSite.IconButton OnSite.HeaderBand OnSite.HeaderBandText
             OnSite.Chip OnSite.ChipText OnSite.StatusCell
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 글꼴: Segoe UI 9pt, 한글은 맑은 고딕으로 대체 (Revit 과 같음) -->
    <FontFamily x:Key="OnSite.FontFamily">Segoe UI, Malgun Gothic</FontFamily>
    <sys:Double x:Key="OnSite.FontSize">13</sys:Double>   <!-- 12 → 13 (ui_reference_research 7절 #11, 대시보드 칸·칩 포함) -->

    <!-- 오류 표시는 칸 아래 빨간 한 줄(OnSite.ValidationText)로 하므로 기본 빨간 테두리 장식은 끈다 -->
    <ControlTemplate x:Key="OnSite.NoErrorTemplate">
        <AdornedElementPlaceholder/>
    </ControlTemplate>

    <!-- ───────── Label / 글자 ───────── -->
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 입력 칸 왼쪽 레이블: 왼쪽 정렬 고정 폭 (ui_spec §7) -->
    <Style x:Key="OnSite.FieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
        <Setter Property="Width" Value="118"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- 단위 글자 ("7 일" 의 "일") -->
    <Style x:Key="OnSite.UnitText" TargetType="TextBlock">
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 회색 보조 설명 ("(가이드라인 2.1.2)") -->
    <Style x:Key="OnSite.HintText" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundHint}"/>
    </Style>

    <!-- 칸 아래 빨간 한 줄 안내. 값이 맞으면 Visibility=Collapsed -->
    <Style x:Key="OnSite.ValidationText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Error}"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- ───────── Button ───────── -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorder}"/>
        <Setter Property="MinHeight" Value="{DynamicResource OnSite.ControlHeight}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource OnSite.CornerRadius}"/>
                        <!-- Windows 11 처럼 아래 테두리만 한 단계 진하게 -->
                        <Border x:Name="bottom" Height="1" VerticalAlignment="Bottom" Margin="2,0"
                                Background="{DynamicResource OnSite.Brush.ControlBorderBottom}"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackgroundHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderHover}"/>
                            <Setter TargetName="bottom" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                            <Setter TargetName="bottom" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderDisabled}"/>
                            <Setter TargetName="bottom" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- [확인] [취소] [적용]: 오른쪽 정렬 StackPanel 안에서 사용. 확인은 IsDefault, 취소는 IsCancel -->
    <Style x:Key="OnSite.DialogButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <!-- 왼쪽 끝 [?] 도움말 버튼 (정사각형) -->
    <Style x:Key="OnSite.HelpButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="{DynamicResource OnSite.ControlHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Content" Value="?"/>
        <Setter Property="ToolTip" Value="도움말 (F1)"/>
    </Style>

    <!-- 도킹 창의 작은 아이콘 버튼 (▶ ❚❚ 등). 평소엔 테두리 없음, 올리면 배경 -->
    <Style x:Key="OnSite.IconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackgroundHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorder}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackgroundPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── TextBox (높이 = OnSite.ControlHeight, 대화상자 23 px) ───────── -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource OnSite.Brush.Accent}"/>
        <Setter Property="Height" Value="{DynamicResource OnSite.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="3,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource OnSite.NoErrorTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource OnSite.CornerRadius}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <Border x:Name="bottom" Height="1" VerticalAlignment="Bottom" Margin="2,0"
                                Background="{DynamicResource OnSite.Brush.ControlBorderBottom}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                            <Setter TargetName="bottom" Property="Background" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.Error}"/>
                            <Setter TargetName="bottom" Property="Background" Value="{DynamicResource OnSite.Brush.Error}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.Background}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderDisabled}"/>
                            <Setter TargetName="bottom" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 숫자 칸: 좁고 오른쪽 정렬, 뒤에 OnSite.UnitText 를 붙인다 -->
    <Style x:Key="OnSite.NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="52"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- ───────── ComboBox (목록에서 고르기만, 직접 입력 없음) ───────── -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.AccentForeground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 칸 전체를 누르면 열리게 하는 투명 토글 (ComboBox·DatePicker 공용) -->
    <ControlTemplate x:Key="OnSite.TransparentToggle" TargetType="ButtonBase">
        <Border Background="Transparent"/>
    </ControlTemplate>

    <!-- 오른쪽 ⌵ 표시 (Windows 11 의 가는 꺾쇠) -->
    <Geometry x:Key="OnSite.ChevronDown">M0,0 L4,4 L8,0</Geometry>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorder}"/>
        <Setter Property="Height" Value="{DynamicResource OnSite.ControlHeight}"/>
        <Setter Property="Padding" Value="4,0,24,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="root">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource OnSite.CornerRadius}"/>
                        <Border x:Name="bottom" Height="1" VerticalAlignment="Bottom" Margin="2,0"
                                Background="{DynamicResource OnSite.Brush.ControlBorderBottom}"/>
                        <Path Data="{StaticResource OnSite.ChevronDown}" Stroke="{DynamicResource OnSite.Brush.Glyph}" StrokeThickness="1"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" IsHitTestVisible="False"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <ToggleButton Template="{StaticResource OnSite.TransparentToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border MinWidth="{Binding ActualWidth, ElementName=root}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource OnSite.Brush.PopupBackground}"
                                    BorderBrush="{DynamicResource OnSite.Brush.ControlBorder}" BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource OnSite.Brush.ControlBackgroundHover}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                            <Setter TargetName="bottom" Property="Background" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderDisabled}"/>
                            <Setter TargetName="bottom" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── DatePicker: ComboBox 와 같은 모양 "2026-10-01 ⌵" (날짜 형식은 Language="ko-KR" 이면 yyyy-MM-dd) ───────── -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource OnSite.Brush.Accent}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorder}"/>
        <Setter Property="Height" Value="{DynamicResource OnSite.ControlHeight}"/>
        <Setter Property="Width" Value="110"/>
        <Setter Property="SelectedDateFormat" Value="Short"/>
        <Setter Property="IsTodayHighlighted" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource OnSite.NoErrorTemplate}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource OnSite.CornerRadius}"/>
                        <Border x:Name="bottom" Height="1" VerticalAlignment="Bottom" Margin="2,0"
                                Background="{DynamicResource OnSite.Brush.ControlBorderBottom}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <!-- 표시는 항상 yyyy-MM-dd (ko-KR 기본 "2026. 10. 1." 대신). 칸에 들어가면 실제 입력 칸이 보인다 -->
                            <DatePickerTextBox x:Name="PART_TextBox" Margin="4,0,0,0" Opacity="0"/>
                            <TextBlock x:Name="shown" Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{Binding SelectedDate, RelativeSource={RelativeSource TemplatedParent}, StringFormat=yyyy-MM-dd}"/>
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False" Template="{StaticResource OnSite.TransparentToggle}"/>
                            <Path Grid.Column="1" Data="{StaticResource OnSite.ChevronDown}" Stroke="{DynamicResource OnSite.Brush.Glyph}"
                                  StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,8,0" IsHitTestVisible="False"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Root}"
                               AllowsTransparency="True" StaysOpen="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                            <Setter TargetName="bottom" Property="Background" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                            <Setter TargetName="PART_TextBox" Property="Opacity" Value="1"/>
                            <Setter TargetName="shown" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.Error}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── CheckBox ───────── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Width="13" Height="13" VerticalAlignment="Center" CornerRadius="2" BorderThickness="1"
                                Background="{DynamicResource OnSite.Brush.InputBackground}" BorderBrush="{DynamicResource OnSite.Brush.Glyph}">
                            <Path x:Name="check" Data="M2,5.5 L4.5,8 L9.5,2.5" Stroke="{DynamicResource OnSite.Brush.AccentForeground}"
                                  StrokeThickness="1.5" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderHover}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource OnSite.Brush.Accent}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.Accent}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.FocusBorder}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.ForegroundDisabled}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.ControlBorderDisabled}"/>
                            <Setter TargetName="box" Property="Background" Value="Transparent"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── GroupBox: 얇은 선 + 선 위에 걸친 제목 (Revit "열기" 창의 "작업 공유") ───────── -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="Padding" Value="10,6,10,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.RowSpan="2" Margin="0,8,0,0" BorderThickness="1"
                                BorderBrush="{DynamicResource OnSite.Brush.GroupBorder}"/>
                        <Border HorizontalAlignment="Left" Margin="7,0,0,0" Padding="3,0" Background="{DynamicResource OnSite.Brush.Background}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── 도킹 창 뿌리: 대시보드 UserControl 에 Style="{DynamicResource OnSite.Pane}" ───────── -->
    <Style x:Key="OnSite.Pane" TargetType="UserControl">
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="FontFamily" Value="{DynamicResource OnSite.FontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource OnSite.FontSize}"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- ───────── 도킹 창: 그룹 머리글 띠 (특성 창의 "그래픽" 띠) ───────── -->
    <Style x:Key="OnSite.HeaderBand" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.HeaderBackground}"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSite.Brush.HeaderForeground}"/>
    </Style>
    <Style x:Key="OnSite.HeaderBandText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.HeaderForeground}"/>
    </Style>

    <!-- 요약 칩: Background·글자색은 StatusColors.xaml 의 OnSite.Status.* / *.Fg 를 지정 -->
    <Style x:Key="OnSite.Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="2"/>
        <Setter Property="Padding" Value="6,1,6,2"/>
        <Setter Property="Margin" Value="0,0,4,4"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="OnSite.ChipText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ───────── Slider (타임라인): 가는 선 + 작은 사각 손잡이, 지나온 구간은 강조색 ───────── -->
    <Style x:Key="OnSite.SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <Border Height="2" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid MinHeight="18">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource OnSite.SliderRepeat}" Command="Slider.DecreaseLarge"
                                              Background="{DynamicResource OnSite.Brush.Accent}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource OnSite.SliderRepeat}" Command="Slider.IncreaseLarge"
                                              Background="{DynamicResource OnSite.Brush.ControlBorder}"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="8" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="t" Background="{DynamicResource OnSite.Brush.ControlBackground}"
                                                    BorderBrush="{DynamicResource OnSite.Brush.Glyph}" BorderThickness="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="t" Property="BorderBrush" Value="{DynamicResource OnSite.Brush.Accent}"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="t" Property="Background" Value="{DynamicResource OnSite.Brush.Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ───────── ScrollBar: 화살표 없는 얇은 막대 (다크에서 흰 기본 스크롤바가 튀지 않게) ───────── -->
    <Style x:Key="OnSite.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="OnSite.ScrollThumb" TargetType="Thumb">
        <Border x:Name="t" Background="{DynamicResource OnSite.Brush.ScrollThumb}" Margin="3"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="t" Property="Background" Value="{DynamicResource OnSite.Brush.Glyph}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.ScrollTrack}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource OnSite.ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource OnSite.ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Template="{StaticResource OnSite.ScrollThumb}"/></Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource OnSite.ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource OnSite.ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Template="{StaticResource OnSite.ScrollThumb}"/></Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ───────── DataGrid: 줄무늬 없음, 가는 격자선, 선택 = 강조색 (특성 창과 같은 줄 높이) ───────── -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.Foreground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource OnSite.Brush.GridLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource OnSite.Brush.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource OnSite.Brush.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource OnSite.Brush.GridLine}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource OnSite.Brush.GridLine}"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="RowHeight" Value="{DynamicResource OnSite.RowHeight}"/>
        <Setter Property="ColumnHeaderHeight" Value="{DynamicResource OnSite.RowHeight}"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.HeaderForeground}"/>
        <Setter Property="Background" Value="{DynamicResource OnSite.Brush.HeaderBackground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource OnSite.Brush.GridLine}" BorderThickness="0,0,1,1">
                        <ContentPresenter Margin="4,0" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="4,0" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource OnSite.Brush.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource OnSite.Brush.AccentForeground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 상태 칸: 배경 = 상태색(바인딩으로 지정), 글자 가운데. 선택돼도 상태색 유지 (행 선택은 층 칸이 보여 줌) -->
    <Style x:Key="OnSite.StatusCell" TargetType="DataGridCell">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
