<!--
  [타설 등록] · [공시체 결과] 입력 창 (모달 — 입력을 받아 명령이 처리, 기존 대화상자 규칙). 저장은 Engine.FieldServer.SubmitLocal —
  휴대폰 [현장 입력]과 같은 검사·문구·파일 쓰기(field_server.py 와 바이트 동일). 틀리면 창을 닫지 않고 빨간 한 줄로 알림. Enter = 기록, Esc = 취소, F1 = 도움말.
-->
<Window x:Class="RevitOnSite.DataEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="타설 등록" WindowStartupLocation="CenterOwner" Style="{DynamicResource OnSite.DialogWindow}" Language="ko-KR">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteDialog.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help"/>
    </Window.CommandBindings>

    <Border Background="{DynamicResource OnSite.Brush.Background}" Padding="12">
        <StackPanel Width="460">
            <GroupBox Header="구역">
                <StackPanel>
                    <TextBlock x:Name="ZoneHint" Style="{StaticResource OnSite.HintText}" TextWrapping="Wrap" Margin="4,2"/>
                    <ListBox x:Name="Zones" Height="150" Margin="0,2,0,0" AutomationProperties.Name="구역"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="PourBox" Header="타설" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="타설일(_D):" Target="{Binding ElementName=PourDate}"/>
                        <DatePicker x:Name="PourDate"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="타설 시각(_T):" Target="{Binding ElementName=PourTime}"/>
                        <TextBox x:Name="PourTime" Width="70" MaxLength="5"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="예: 08:00 (강도 계산 시작 시각)" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="배합(_M):" Target="{Binding ElementName=Mix}"/>
                        <ComboBox x:Name="Mix" Width="160"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="fck(_F):" Target="{Binding ElementName=Fck}"/>
                        <TextBox x:Name="Fck" Style="{StaticResource OnSite.NumberBox}"/>
                        <TextBlock Style="{StaticResource OnSite.UnitText}" Text="MPa"/>
                    </StackPanel>
                    <!-- v6.2 W1: 같이 친 구역 묶음 번호 (선택) — 넣으면 공시체 결과를 묶음으로 한 번에 -->
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="타설 묶음(_G):" Target="{Binding ElementName=PourLot}"/>
                        <TextBox x:Name="PourLot" Width="110" MaxLength="40"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="선택 — 예: P-9F-1. 넣으면 공시체 한 번으로 묶음 전체 (같은 날·배합·fck)" Margin="6,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
                    </StackPanel>
                    <!-- 11-12 Revit #7: 타설 입회 (선택) — 품질 대장 '타설 입회 기록 없음' 점검 -->
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="입회 감리(_V):" Target="{Binding ElementName=Witness}"/>
                        <ComboBox x:Name="Witness" Width="80" SelectedIndex="0">
                            <ComboBoxItem Content=""/>
                            <ComboBoxItem Content="예"/>
                            <ComboBoxItem Content="아니오"/>
                        </ComboBox>
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="감시자(_W):" Target="{Binding ElementName=Watcher}" Margin="8,0,0,0"/>
                        <TextBox x:Name="Watcher" Width="100" MaxLength="20"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="선택 — 타설 중 감시자 이름" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="CylBox" Header="현장양생 공시체 (해체 판정의 기준 근거)" Margin="0,8,0,0">
                <StackPanel>
                    <!-- v6.2 W1: 구역 하나 또는 타설 묶음 (묶음의 모든 구역 공통 시험) -->
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="타설 묶음(_G):" Target="{Binding ElementName=CylLot}"/>
                        <ComboBox x:Name="CylLot" Width="300" SelectionChanged="LotChanged"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="시험일(_D):" Target="{Binding ElementName=TestDate}"/>
                        <DatePicker x:Name="TestDate"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="양생 방법(_C):" Target="{Binding ElementName=Curing}"/>
                        <ComboBox x:Name="Curing" Width="160"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="강도 3개(_S):" Target="{Binding ElementName=F1}"/>
                        <TextBox x:Name="F1" Style="{StaticResource OnSite.NumberBox}" AutomationProperties.Name="강도 1"/>
                        <TextBox x:Name="F2" Style="{StaticResource OnSite.NumberBox}" Margin="4,0,0,0" AutomationProperties.Name="강도 2"/>
                        <TextBox x:Name="F3" Style="{StaticResource OnSite.NumberBox}" Margin="4,0,0,0" AutomationProperties.Name="강도 3"/>
                        <TextBlock Style="{StaticResource OnSite.UnitText}" Text="MPa"/>
                    </StackPanel>
                    <Expander Header="채취 정보 (선택 — 판정에는 안 씀)" Margin="0,4,0,0">
                        <StackPanel Margin="0,2,0,0">
                            <StackPanel Style="{StaticResource Row}">
                                <Label Style="{StaticResource OnSite.FieldLabel}" Content="타설 번호:" Target="{Binding ElementName=PourId}"/>
                                <TextBox x:Name="PourId" Width="160" MaxLength="40"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <Label Style="{StaticResource OnSite.FieldLabel}" Content="채취 시각:" Target="{Binding ElementName=SampledAt}"/>
                                <TextBox x:Name="SampledAt" Width="160" MaxLength="16" ToolTip="2026-12-30 09:00 처럼 (타설일 이후, 시험일 이전)"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <Label Style="{StaticResource OnSite.FieldLabel}" Content="레미콘 회사:" Target="{Binding ElementName=Supplier}"/>
                                <TextBox x:Name="Supplier" Width="160" MaxLength="40"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <Label Style="{StaticResource OnSite.FieldLabel}" Content="차량 번호:" Target="{Binding ElementName=TruckNo}"/>
                                <TextBox x:Name="TruckNo" Width="160" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Style="{StaticResource Row}">
                                <Label Style="{StaticResource OnSite.FieldLabel}" Content="보관 위치:" Target="{Binding ElementName=Storage}"/>
                                <TextBox x:Name="Storage" Width="160" MaxLength="40"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <!-- 11-12 Revit #9: 시험성적서 파일 (선택) → 근거 원장 3 공시체 줄에 경로·SHA-256 (검측 패키지 첨부) -->
                    <StackPanel Style="{StaticResource Row}" Margin="0,4,0,0">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="시험성적서(_R):" Target="{Binding ElementName=Report}"/>
                        <TextBox x:Name="Report" Width="220"/>
                        <Button Content="찾기…" Margin="4,0,0,0" Padding="8,0" Click="BrowseReport"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="선택 — PDF·사진" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="기록" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="입력자(_N):" Target="{Binding ElementName=Actor}"/>
                        <TextBox x:Name="Actor" Width="200" MaxLength="20"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="메모:" Target="{Binding ElementName=Note}"/>
                        <TextBox x:Name="Note" Width="300" MaxLength="200"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="ErrorText" Style="{StaticResource OnSite.ValidationText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Style="{StaticResource OnSite.HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="휴대폰 [현장 입력]과 같은 검사로 데이터 폴더에 한 줄씩 더합니다. 판정 기준일이 있으면 판정을 다시 계산합니다. 잘못 넣은 기록은 구역 정보 창 [타설·공시체 기록 취소] 뒤 다시 넣습니다 (원래 줄은 파일에 남음)."/>

            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.HelpButton}" Command="Help"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="취소" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="기록" IsDefault="True" x:Name="OkButton" Click="Ok"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
