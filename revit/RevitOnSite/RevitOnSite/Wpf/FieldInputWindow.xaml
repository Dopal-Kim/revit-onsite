<!--
  현장 입력 창 — ui_spec §7 대화상자 규칙 (모달 아님: 열어 둔 동안 휴대폰 입력을 받는다). 서버 켜고 끄기는 FieldInput.cs.
  QR 코드 = 첫 번째 접속 주소 (Engine.Qr, 외부 패키지 없음). 닫으면 서버도 꺼진다.
  28차 (총괄): 탭 둘 [현장 입력] / [협력업체 신고] — 신고 QR 을 펼치면 창이 길어져 [닫고 입력 끄기]가 화면 밖·리본 승인 패널을 가리던 것.
  본문은 스크롤, 아래 버튼 줄은 고정, 높이 상한 = Revit 창의 리본 아래 영역, 처음 위치 = Revit 창 오른쪽 아래 (코드 PlaceBottomRight).
-->
<Window x:Class="RevitOnSite.FieldInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="현장 입력" WindowStartupLocation="Manual" Style="{DynamicResource OnSite.DialogWindow}" Language="ko-KR">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteDialog.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help"/>
    </Window.CommandBindings>

    <Border Background="{DynamicResource OnSite.Brush.Background}" Padding="12">
        <DockPanel Width="380">
            <!-- 아래 버튼 줄: 스크롤 밖에 고정 -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.HelpButton}" Command="Help"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="닫고 입력 끄기" Click="CloseClick"/><!-- IsCancel 없음: Revit 에서 Esc 로 명령 취소할 때 창·서버가 같이 꺼지던 문제 (N15) -->
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <TabControl x:Name="Tabs" SelectionChanged="TabChanged">
                        <TabItem Header="현장 입력" AutomationProperties.Name="현장 입력 QR (품질·안전관리자)">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="휴대폰 카메라로 QR 코드를 찍으세요 (현장 PC 와 같은 Wi-Fi)"/>
                                <Border Background="White" BorderBrush="#C8C8C8" BorderThickness="1" Margin="0,8" Padding="0" HorizontalAlignment="Center">
                                    <Image x:Name="QrImage" Width="232" Height="232" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="접속 주소 QR 코드"/>
                                </Border>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="주소 복사(_C)" Click="CopyUrl" Margin="6,0,0,0"/>
                                    <TextBox x:Name="UrlBox" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="접속 주소"/>
                                </DockPanel>
                                <TextBlock x:Name="OtherUrls" Style="{StaticResource OnSite.HintText}" Margin="0,3,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                <!-- 열 주소·새 주소 (F6): 기본 = 첫 LAN 주소 하나, 접속 주소는 12시간 [가정] 뒤 만료 -->
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="새 주소(_N)" Click="NewUrl" Margin="6,0,0,0"
                                            ToolTip="접속 주소(QR)를 새로 만듭니다. 옛 QR 로는 더 열 수 없고, 만료 시각도 지금부터 다시 셉니다."/>
                                    <Label DockPanel.Dock="Left" Content="열 주소(_H):" Target="{Binding ElementName=HostBox}" Padding="0,0,6,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="HostBox" ToolTip="휴대폰이 들어올 이 PC 의 주소. 기본은 첫 LAN 주소 하나 — '모든 망'은 테더링·공용망에도 같이 열립니다."/>
                                </DockPanel>
                                <TextBlock x:Name="State" Style="{StaticResource OnSite.HintText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </TabItem>
                        <!-- F14 협력업체 해체 신고 QR — 층 표지 QR(보기 전용)·입력 QR 과 다른 주소 (신고 토큰 report_token.txt, 만료 없음) -->
                        <TabItem x:Name="ReportTab" Header="협력업체 신고" AutomationProperties.Name="협력업체 해체 신고 QR (반장에게 따로)">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="해체하는 협력업체 반장에게 따로 보여 줄 QR (층마다)"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Label DockPanel.Dock="Left" Content="층(_F):" Target="{Binding ElementName=ReportFloor}" Padding="0,0,6,0" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ReportFloor" SelectionChanged="ShowReport" AutomationProperties.Name="신고 층"/>
                                </DockPanel>
                                <Border Background="White" BorderBrush="#C8C8C8" BorderThickness="1" Margin="0,8" HorizontalAlignment="Center">
                                    <Image x:Name="ReportQr" Width="232" Height="232" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="해체 신고 QR 코드"/>
                                </Border>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="신고 주소 복사" Click="CopyReport" Margin="6,0,0,0"/>
                                    <TextBox x:Name="ReportUrlBox" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="신고 주소"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource OnSite.HintText}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="반장이 구역마다 [이 구역 동바리를 뺐음]·[다시 세움]을 누르면 동바리 확인 기록에 '협력업체 신고'로 남습니다(사진 1장 선택). 감리 승인 기록 없이 '뺐음'이면 대시보드 알림 맨 위에 '무단 해체 의심'. 층 표지 QR(보기 전용)과 다른 주소이며 만료되지 않습니다."/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <GroupBox Header="받은 기록" Margin="0,8,0,0">
                        <ListBox x:Name="LogList" Height="120" BorderThickness="0" AutomationProperties.Name="받은 기록"/>
                    </GroupBox>

                    <TextBlock Style="{StaticResource OnSite.HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="받은 값은 데이터 폴더 CSV 에 한 줄씩 더해지고, 판정을 다시 계산해 구역 값·센서 표식에 적습니다 (모델을 바꿉니다). 처음 켤 때 Windows 방화벽 창이 뜨면 '개인 네트워크' 허용을 눌러 주세요. 이 창을 닫으면 입력을 그만 받습니다."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
