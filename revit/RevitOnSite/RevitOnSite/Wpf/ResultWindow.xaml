<!--
  결과 창 — 성공 결과 알림(해체 판정·구역·동바리 생성·승인 기록·근거 원장)을 모달 아닌 창 하나로 (총괄 결정 11-04).
  열려 있어도 Revit 작업·대시보드 [판정]·Revit 종료를 막지 않는다. 하나만 두고 새 결과가 오면 내용을 바꾸고 앞으로.
  키보드 포커스는 Revit 뷰에 남김(ShowActivated=False, N9 와 같은 이유) — 창을 누를 때만 창으로. 오류·실패·확인 질문은 TaskDialog 모달 그대로 (App.Message).
-->
<Window x:Class="RevitOnSite.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit On-Site — 결과" WindowStartupLocation="CenterOwner" Style="{DynamicResource OnSite.DialogWindow}" Language="ko-KR"
        ShowActivated="False" PreviewKeyDown="KeyPressed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteDialog.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{DynamicResource OnSite.Brush.Background}" Padding="12">
        <DockPanel Width="460">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" x:Name="AtText" Style="{StaticResource OnSite.HintText}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="닫기" IsCancel="True" IsDefault="True" Click="CloseClick"/>
                <!-- 결과에 붙는 다음 동작 하나 (예: 구역·동바리 생성 → [생성한 동바리 보기], V1). 없으면 숨김 -->
                <Button DockPanel.Dock="Right" x:Name="ActionButton" Style="{StaticResource OnSite.DialogButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="ActionClick"/>
            </DockPanel>
            <!-- 구조 (ui_reference_research 7절 #8): 굵은 요약 한 줄(숫자 포함) → ▲ 경고 따로 → 접는 상세 -->
            <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <ItemsControl DockPanel.Dock="Top" x:Name="WarnList" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="경고">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource OnSite.Brush.Error}" Margin="0,0,0,2"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander x:Name="Detail" Header="상세" AutomationProperties.Name="상세">
                <ScrollViewer x:Name="BodyScroll" MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                    <TextBlock x:Name="BodyText" TextWrapping="Wrap" Margin="0,0,8,0"/>
                </ScrollViewer>
            </Expander>
        </DockPanel>
    </Border>
</Window>
