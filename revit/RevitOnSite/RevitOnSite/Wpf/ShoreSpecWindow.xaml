<!--
  [동바리 사양] 창 (v6 2단계) — 층(·구역) 동바리 종류·규격·간격·이음·설치일 → Engine.FieldServer.SubmitLocal 종류 shore_spec (휴대폰과 같은 검사, shore_spec.csv).
  위에 그 층 기록을 보여 줌 (조회). 틀리면 창을 닫지 않고 빨간 한 줄. Enter = 기록, Esc = 닫기, F1 = 도움말.
-->
<Window x:Class="RevitOnSite.ShoreSpecWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="동바리 사양" WindowStartupLocation="CenterOwner" Style="{DynamicResource OnSite.DialogWindow}" Language="ko-KR">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RevitOnSite;component/Wpf/OnSiteDialog.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="Margin" Value="0,3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="Help" Executed="Help"/>
    </Window.CommandBindings>

    <Border Background="{DynamicResource OnSite.Brush.Background}" Padding="12">
        <StackPanel Width="460">
            <GroupBox x:Name="HaveBox" Header="이 층에 넣은 사양">
                <TextBlock x:Name="Have" Style="{StaticResource OnSite.HintText}" TextWrapping="Wrap" Margin="4,2" AutomationProperties.Name="이 층에 넣은 사양"/>
            </GroupBox>

            <GroupBox Header="동바리 사양 (판정 미사용 — 놓기 간격·3개층 확인 표·휴대폰 층 화면)" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="층:"/>
                        <TextBlock x:Name="FloorText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="구역(_Z):" Target="{Binding ElementName=Zone}"/>
                        <ComboBox x:Name="Zone" Width="160"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="층 전체 = 모든 구역 (구역 줄이 있으면 그 구역 우선)" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="200"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="종류(_K):" Target="{Binding ElementName=Kind}"/>
                        <ComboBox x:Name="Kind" Width="160"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="규격(_S):" Target="{Binding ElementName=Spec}"/>
                        <TextBox x:Name="Spec" Width="160" MaxLength="40" ToolTip="예: V4 (파이프 서포트 형번) · 제품 규격"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="간격 X·Y(_G):" Target="{Binding ElementName=SpacingX}"/>
                        <TextBox x:Name="SpacingX" Style="{StaticResource OnSite.NumberBox}" AutomationProperties.Name="X 간격"/>
                        <TextBox x:Name="SpacingY" Style="{StaticResource OnSite.NumberBox}" Margin="4,0,0,0" AutomationProperties.Name="Y 간격"/>
                        <TextBlock Style="{StaticResource OnSite.UnitText}" Text="mm (조립도 값)"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="이음 수(_J):" Target="{Binding ElementName=Splices}"/>
                        <TextBox x:Name="Splices" Style="{StaticResource OnSite.NumberBox}"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="개 (이음 1개 이하 규칙은 설치 검측이 봄)" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="허용하중(_A):" Target="{Binding ElementName=Allowable}"/>
                        <TextBox x:Name="Allowable" Style="{StaticResource OnSite.NumberBox}" AutomationProperties.Name="허용하중 kN (제품 성적서)"/>
                        <TextBlock Style="{StaticResource OnSite.UnitText}" Text="kN/본"/>
                        <TextBlock Style="{StaticResource OnSite.HintText}" Text="제품 성적서 값 — 비우면 13.3 (40 ÷ 안전율 3). 설치 검측 1본 하중이 이 값으로" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="설치일(_D):" Target="{Binding ElementName=InstallDate}"/>
                        <DatePicker x:Name="InstallDate"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="기록" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="입력자(_N):" Target="{Binding ElementName=Actor}"/>
                        <TextBox x:Name="Actor" Width="200" MaxLength="20"/>
                    </StackPanel>
                    <StackPanel Style="{StaticResource Row}">
                        <Label Style="{StaticResource OnSite.FieldLabel}" Content="메모:" Target="{Binding ElementName=Note}"/>
                        <TextBox x:Name="Note" Width="300" MaxLength="200"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="ErrorText" Style="{StaticResource OnSite.ValidationText}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/>
            <TextBlock Style="{StaticResource OnSite.HintText}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="휴대폰 [현장 입력]과 같은 검사로 데이터 폴더 shore_spec.csv 에 한 줄 더합니다. 고치려면 같은 층·구역을 그 날 이후 설치일로 다시 넣습니다 (마지막 줄을 씀)."/>

            <DockPanel Margin="0,12,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource OnSite.HelpButton}" Command="Help"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="닫기" IsCancel="True"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource OnSite.DialogButton}" Content="기록" IsDefault="True" Click="Ok"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
